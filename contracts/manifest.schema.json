{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NativeHTMLKit AppShell extension manifest v1",
  "description": "Identical JSON shape returned by Python method and PowerShell module operation. Semantic referential checks documented separately.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "id",
    "title",
    "version",
    "pages"
  ],
  "properties": {
    "api_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "maxLength": 140,
      "pattern": "^[a-z][a-z0-9]*(?:\\.[a-z][a-z0-9-]*)+$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "platforms": {
      "type": "array",
      "items": {
        "enum": [
          "linux",
          "windows"
        ]
      },
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "maxLength": 500
          },
          "order": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9999
          }
        }
      }
    },
    "commands": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "risk"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "risk": {
            "enum": [
              "read",
              "write",
              "destructive"
            ]
          },
          "confirmation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "risk": {
                  "enum": [
                    "write",
                    "destructive"
                  ]
                }
              },
              "required": [
                "risk"
              ]
            },
            "then": {
              "required": [
                "confirmation"
              ]
            }
          }
        ]
      }
    }
  }
}
