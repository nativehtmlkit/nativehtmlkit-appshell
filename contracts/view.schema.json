{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NativeHTMLKit AppShell view v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "blocks"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "blocks": {
      "type": "array",
      "maxItems": 300,
      "items": {
        "$ref": "#/$defs/block"
      }
    }
  },
  "$defs": {
    "text": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "text"
      ],
      "properties": {
        "kind": {
          "const": "text"
        },
        "text": {
          "type": "string",
          "maxLength": 10000
        }
      }
    },
    "caption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "text"
      ],
      "properties": {
        "kind": {
          "const": "caption"
        },
        "text": {
          "type": "string",
          "maxLength": 10000
        }
      }
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "text"
      ],
      "properties": {
        "kind": {
          "const": "code"
        },
        "text": {
          "type": "string",
          "maxLength": 10000
        }
      }
    },
    "badge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "text"
      ],
      "properties": {
        "kind": {
          "const": "badge"
        },
        "text": {
          "type": "string",
          "maxLength": 10000
        }
      }
    },
    "heading": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "text"
      ],
      "properties": {
        "kind": {
          "const": "heading"
        },
        "text": {
          "type": "string",
          "maxLength": 300
        },
        "level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        }
      }
    },
    "notice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "text"
      ],
      "properties": {
        "kind": {
          "const": "notice"
        },
        "text": {
          "type": "string",
          "maxLength": 5000
        },
        "tone": {
          "enum": [
            "info",
            "success",
            "warning",
            "danger"
          ]
        }
      }
    },
    "divider": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "const": "divider"
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "label"
      ],
      "properties": {
        "kind": {
          "const": "input"
        },
        "name": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "value": {
          "type": "string",
          "maxLength": 2000
        },
        "placeholder": {
          "type": "string",
          "maxLength": 2000
        },
        "password": {
          "type": "boolean"
        }
      }
    },
    "textarea": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "label"
      ],
      "properties": {
        "kind": {
          "const": "textarea"
        },
        "name": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "value": {
          "type": "string",
          "maxLength": 10000
        }
      }
    },
    "checkbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "label"
      ],
      "properties": {
        "kind": {
          "const": "checkbox"
        },
        "name": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "checked": {
          "type": "boolean"
        }
      }
    },
    "select": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "name",
        "label",
        "options"
      ],
      "properties": {
        "kind": {
          "const": "select"
        },
        "name": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "value": {
          "type": "string",
          "maxLength": 1000
        },
        "options": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "value",
              "label"
            ],
            "properties": {
              "value": {
                "type": "string",
                "maxLength": 1000
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            }
          }
        }
      }
    },
    "button": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "text",
        "command"
      ],
      "properties": {
        "kind": {
          "const": "button"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "command": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "params": {
          "type": "object",
          "maxProperties": 50,
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean",
              "null"
            ]
          }
        }
      }
    },
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "columns",
        "rows"
      ],
      "properties": {
        "kind": {
          "const": "table"
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "key",
              "title"
            ],
            "properties": {
              "key": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[a-z][a-z0-9_-]*$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              }
            }
          }
        },
        "rows": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "maxProperties": 24,
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "integer",
                "boolean",
                "null"
              ]
            }
          }
        }
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "children"
      ],
      "properties": {
        "kind": {
          "const": "card"
        },
        "children": {
          "type": "array",
          "maxItems": 300,
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      }
    },
    "row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "children"
      ],
      "properties": {
        "kind": {
          "const": "row"
        },
        "children": {
          "type": "array",
          "maxItems": 300,
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "children"
      ],
      "properties": {
        "kind": {
          "const": "column"
        },
        "children": {
          "type": "array",
          "maxItems": 300,
          "items": {
            "$ref": "#/$defs/block"
          }
        }
      }
    },
    "block": {
      "oneOf": [
        {
          "$ref": "#/$defs/heading"
        },
        {
          "$ref": "#/$defs/text"
        },
        {
          "$ref": "#/$defs/caption"
        },
        {
          "$ref": "#/$defs/code"
        },
        {
          "$ref": "#/$defs/badge"
        },
        {
          "$ref": "#/$defs/notice"
        },
        {
          "$ref": "#/$defs/divider"
        },
        {
          "$ref": "#/$defs/input"
        },
        {
          "$ref": "#/$defs/textarea"
        },
        {
          "$ref": "#/$defs/checkbox"
        },
        {
          "$ref": "#/$defs/select"
        },
        {
          "$ref": "#/$defs/button"
        },
        {
          "$ref": "#/$defs/table"
        },
        {
          "$ref": "#/$defs/card"
        },
        {
          "$ref": "#/$defs/row"
        },
        {
          "$ref": "#/$defs/column"
        }
      ]
    }
  }
}
